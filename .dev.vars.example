# Local development secrets for `wrangler dev` (V2). Copy to .dev.vars.
# Never commit real values.
#
# Note: outbound form email needs NO secret — it flows through the native
# Cloudflare Email Service send_email binding (EMAIL), which wrangler dev
# simulates locally by default (messages are logged, not delivered).

# AI providers
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
KIE_API_KEY=
CF_AIG_TOKEN=

# Deployment (preview/publication deploy API)
CF_DEPLOY_API_TOKEN=

# Inbound route HMAC (onboarding/revision/build-create webhooks)
WEBHOOK_SECRET=

# Form Service bot protection
TURNSTILE_SECRET_KEY=

# Operator capability tokens for Approval/Rollback routes (issue #29)
OPERATOR_CAPABILITY_SECRET=
