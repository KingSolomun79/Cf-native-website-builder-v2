{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cf-website-factory-v2",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "c1c0f6b100d55a09ce6a7a3121a19224",

  // Issue #55: explicit CPU budget. The production experiment on build
  // 91764d47 (2026-09-06) died repeatedly on the 30s default ("Worker
  // exceeded CPU time limit"). Local profiling against that build's real
  // artifacts showed the deterministic floor is the vision-input preparation
  // (~0.5s CPU per provider call on the oversized reference screenshot,
  // ~13 calls inside one generation-step invocation, plus multi-MB GC
  // pressure) — now memoized per invocation — while the whole deterministic
  // assembly-validation path measures ~2ms. 120s gives >4x headroom over the
  // measured un-memoized floor and ample GC allowance, while staying well
  // under the 300s platform maximum so a genuinely runaway invocation still
  // fails fast. Provider WAITING does not consume CPU budget (network time).
  "limits": {
    "cpu_ms": 120000
  },

  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "website_factory_v2",
      "database_id": "9e2597d1-9598-4c50-adcf-764c1b6319da"
    }
  ],

  "r2_buckets": [
    {
      "binding": "SITE_BUCKET",
      "bucket_name": "website-factory-v2-assets"
    }
  ],


  "workflows": [
    {
      "name": "website-build-workflow",
      "binding": "WEBSITE_BUILD_WORKFLOW",
      "class_name": "WebsiteBuildWorkflow"
    }
  ],

  // Outbound email transport: the native Cloudflare Email Service binding
  // (issue #28 follow-up). The `from` address must belong to a domain
  // onboarded to Email Sending in the dashboard (Compute > Email Service >
  // Email Sending > Onboard Domain — Cloudflare writes the cf-bounce
  // MX/SPF/DKIM and DMARC records). Before that onboarding, sends fail
  // closed with E_SENDER_DOMAIN_NOT_AVAILABLE (bounded transient retry).
  // Once the platform sender domain is onboarded, consider tightening this
  // binding with allowed_sender_addresses to the approved platform senders.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],

  // Fires the bounded Email Delivery retry sweep (issue #28): transient
  // delivery failures retry server-side without visitor resubmission.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "browser": {
    "binding": "BROWSER"
  },

  "images": {
    "binding": "IMAGES"
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },

  "vars": {
    "CF_ACCOUNT_ID": "c1c0f6b100d55a09ce6a7a3121a19224",
    "CF_AI_GATEWAY_ID": "website-factory",
    "PUBLIC_APP_URL": "https://cf-website-factory-v2.wazibizwebsites.workers.dev",
    // Platform Sender Identity (issue #32/#33): the operator-approved mailbox
    // on wazibiz.ke, the domain onboarded to Cloudflare Email Service Email
    // Sending (Enabled, 2026-09-02). Configuration, not a secret.
    "WAZIBIZ_SENDER_EMAIL": "notifications@wazibiz.ke",
    "KIE_API_URL": "https://api.kie.ai",
    "KIE_MODEL": "z-image",
    // Durable image lifecycle (issue #58): the poll cadence and the per-attempt
    // provider wait bound for the submit -> sleep -> poll state machine.
    // Worst-case durable poll steps = 12 slots x 2 attempts x ceil(timeout /
    // interval) = 24 x 30 = 720 step.do calls (step.sleep does NOT count
    // toward the Workflow step limit) — inside the documented 10,000-step
    // paid-plan default. Raising the timeout requires re-checking that budget.
    "KIE_POLL_INTERVAL_MS": "30000",
    "KIE_ATTEMPT_TIMEOUT_MS": "900000",
    "ZHIPU_API_URL": "https://api.z.ai/api/coding/paas/v4",
    "ZHIPU_GATEWAY_PROVIDER": "custom-zhipu",
    // One canonical LLM model for ALL V2 textual and multimodal calls
    // (operator decision, issue #30): glm-5.3-flash on every provider leg.
    // Provider failover (ZAI primary -> Cloudflare AI Gateway fallback, via
    // src/lib/ai-gateway.ts key-driven chains) must keep serving exactly
    // this model; a fallback to a different model is a routing defect. The
    // OpenRouter leg stays coded but dormant without OPENROUTER_API_KEY.
    "LLM_MODEL": "glm-5.3-flash",
    "PRIMARY_PROVIDER": "zhipu",
    "VISION_PRIMARY_PROVIDER": "zhipu",
    "VISION_FALLBACK_PROVIDER": "ai-gateway",
    "VISION_REQUEST_TIMEOUT_MS": "120000",
    "VISION_MAX_ATTEMPTS_PER_PROVIDER": "2",
    "VISION_RETRY_DELAY_MS": "500",
    "VISION_INPUT_MAX_BYTES": "4194304",
    "VISION_INPUT_MAX_WIDTH": "1920",
    "VISION_INPUT_MAX_HEIGHT": "12000"
  },

  // Staging-equivalent deployment for controlled verification (issue #28).
  // Separate Worker name + separate D1 so production (still V1-live until
  // the #27 release runbook executes) and prod D1 are never touched. Note
  // wrangler environments do NOT inherit top-level bindings/vars — this
  // environment deliberately binds only what the Form Service smoke path
  // needs (D1, native Email Service binding, cron sweep):
  //   npx wrangler d1 migrations apply website_factory_staging --remote --env staging
  //   npx wrangler deploy --env staging
  "env": {
    "staging": {
      "name": "cf-website-factory-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "website_factory_staging",
          "database_id": "c347bcf9-b349-40db-b5a4-f507d8710795"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "triggers": {
        "crons": ["*/10 * * * *"]
      },
      "vars": {
        "PUBLIC_APP_URL": "https://cf-website-factory-staging.wazibizwebsites.workers.dev",
        // Platform Sender Identity (issue #32): the operator-approved
        // mailbox on wazibiz.ke — the domain onboarded to Cloudflare Email
        // Service / Email Sending on 2026-09-02 (guided #33 setup). The
        // sender address is configuration, not a secret. The production
        // environment deliberately does NOT define this var until the #27
        // deploy re-points the top-level config: delivery fails closed
        // without it.
        "WAZIBIZ_SENDER_EMAIL": "notifications@wazibiz.ke"
      }
    }
  }
}
