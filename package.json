{
  "name": "cf-website-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:test": "wrangler d1 migrations apply DB --local --config wrangler.test.jsonc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/playwright": "^1.3.3",
    "@cloudflare/vitest-pool-workers": "^0.12.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@sinclair/typebox": "^0.34.52",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
