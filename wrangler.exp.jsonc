{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // SANDBOX / EXPERIMENTAL RUNTIME (originally stood up for the SIMPLE design
  // pipeline experiment; now the durable V2 sandbox). Deploy with:
  //   CLOUDFLARE_ACCOUNT_ID=c1c0f6b100d55a09ce6a7a3121a19224 \
  //     npx wrangler deploy -c wrangler.exp.jsonc
  // It shares the operator's sandbox Worker with the retained V2 secrets
  // (ZAI_CODING_API_KEY / KIE_API_KEY / CF_DEPLOY_API_TOKEN / WEBHOOK_SECRET) —
  // the canonical credential name, identical to production (final secret
  // hygiene 2026-09-12); no secret ever leaves the platform.
  //
  // RESOURCE ISOLATION (post-rollout hardening, 2026-09-12): every
  // environment-sensitive Cloudflare resource name here is DISTINCT from the
  // production config (wrangler.jsonc) — Worker name, D1 database, R2 bucket
  // and especially the WORKFLOW RESOURCE NAME. A full `wrangler deploy`
  // associates the named Workflow resource with the Worker being deployed,
  // so a shared workflow name lets one environment's deploy steal the other
  // environment's Workflow (observed live during the production rollout:
  // sandbox deploys left production instances executing against sandbox
  // bindings). The Worker-level BINDING name (WEBSITE_BUILD_WORKFLOW) may be
  // identical — it is scoped inside each Worker. Enforced by
  // scripts/verify-resource-isolation.mjs, which runs as part of `npm test`.
  // See v2-docs/CLOUDFLARE-RESOURCE-ISOLATION-RUNBOOK.md.
  "name": "cf-website-factory-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "c1c0f6b100d55a09ce6a7a3121a19224",
  "limits": {
    "cpu_ms": 120000
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "website_factory_v2_simple_exp",
      "database_id": "81084e55-bd84-4099-ad5b-78b5dab5b63d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SITE_BUCKET",
      "bucket_name": "website-factory-v2-simple-exp-assets"
    }
  ],
  "workflows": [
    {
      // Deliberately NOT website-build-workflow: that resource belongs to the
      // production Worker (cf-website-factory-v2). A shared name let a sandbox
      // deploy capture production's Workflow and route its instances to
      // sandbox bindings (proven during the 2026-09-12 production rollout).
      "name": "website-build-workflow-sandbox",
      "binding": "WEBSITE_BUILD_WORKFLOW",
      "class_name": "WebsiteBuildWorkflow"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "CF_ACCOUNT_ID": "c1c0f6b100d55a09ce6a7a3121a19224",
    "PUBLIC_APP_URL": "https://cf-website-factory-sandbox.wazibizwebsites.workers.dev",
    "WAZIBIZ_SENDER_EMAIL": "notifications@wazibiz.ke",
    "KIE_API_URL": "https://api.kie.ai",
    "KIE_MODEL": "nano-banana-2-lite",
    "KIE_POLL_INTERVAL_MS": "30000",
    "KIE_ATTEMPT_TIMEOUT_MS": "900000",
    // ZAI GLM CODING PLAN (operator GO 2026-09-11): the ONE LLM provider.
    // The credential is ZAI_CODING_API_KEY — the same canonical secret name
    // as production (final secret hygiene 2026-09-12); the retired legacy
    // alias name is gone from source and from both Workers, which passed
    // Coding Plan canaries on the canonical name before its removal.
    "ZAI_CODING_BASE_URL": "https://api.z.ai/api/coding/paas/v4",
    "ZAI_CODING_MODEL": "glm-5.3",
    "ZAI_MULTIMODAL_MODEL": "glm-5.3-flash",
    // Visual-input preparation bounds (shared with production; consumed by
    // src/domain/stage-execution.ts and src/lib/vision-input.ts).
    "VISION_REQUEST_TIMEOUT_MS": "120000",
    "VISION_MAX_ATTEMPTS_PER_PROVIDER": "2",
    "VISION_RETRY_DELAY_MS": "500",
    "VISION_INPUT_MAX_BYTES": "4194304",
    "VISION_INPUT_MAX_WIDTH": "1920",
    "VISION_INPUT_MAX_HEIGHT": "12000"
  }
}
