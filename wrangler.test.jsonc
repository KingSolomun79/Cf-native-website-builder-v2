{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cf-website-factory-test",
  "main": "./tests/worker-entry.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "website_factory_test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SITE_BUCKET",
      "bucket_name": "website-factory-assets-test"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "PUBLIC_APP_URL": "https://test.example.com",
    "WEBHOOK_SECRET": "test-webhook-secret",
    "OPERATOR_CAPABILITY_SECRET": "test-operator-capability-secret",
    "WAZIBIZ_SENDER_EMAIL": "noreply@staging.wazibiz.example",
    "KIE_API_URL": "https://kie.example.com",
    "KIE_API_KEY": "test-kie-key",
    "KIE_MODEL": "nano-banana-2-lite",
    "LLM_MODEL": "glm-5.3-flash",
    "DESIGN_PIPELINE_VERSION": "simple_blueprint_v1",
    "CF_ACCOUNT_ID": "test-account",
    "CF_DEPLOY_API_TOKEN": "test-deploy-token",
    "OPENROUTER_API_KEY": "test-or-key",
    "CF_AIG_TOKEN": "test-aig"
  }
}
